#!/usr/bin/env python3
"""Extract Strategy's October 2026 STRC dividend event into a Signal W5H draft."""

from __future__ import annotations

import argparse
import json
import re
from datetime import datetime, timedelta, timezone
from decimal import Decimal
from html.parser import HTMLParser
from pathlib import Path
from typing import Any

from validate_signal_event import validate_event


ROOT = Path(__file__).resolve().parents[1]
# Every timestamp extracted by this bounded October/November 1, 2026 case is
# explicitly Eastern Daylight Time in the filing. Keeping the offset local
# avoids an optional tzdata dependency on Windows runners.
EASTERN = timezone(timedelta(hours=-4))
DEFAULT_FILING_URL = (
    "https://www.sec.gov/Archives/edgar/data/1050446/000119312526423400/"
    "mstr-20261015.htm"
)
DEFAULT_INDEX_URL = (
    "https://www.sec.gov/Archives/edgar/data/1050446/000119312526423400/"
    "0001193125-26-423400-index.htm"
)


class ExtractionFailure(ValueError):
    """Raised when a required disclosure fact cannot be found unambiguously."""


class _TextCollector(HTMLParser):
    def __init__(self) -> None:
        super().__init__(convert_charrefs=True)
        self.parts: list[str] = []
        self.ignored_depth = 0

    def handle_starttag(self, tag: str, attrs: list[tuple[str, str | None]]) -> None:
        if tag in {"script", "style"}:
            self.ignored_depth += 1

    def handle_endtag(self, tag: str) -> None:
        if tag in {"script", "style"} and self.ignored_depth:
            self.ignored_depth -= 1

    def handle_data(self, data: str) -> None:
        if not self.ignored_depth:
            self.parts.append(data)


def html_text(source: str) -> str:
    parser = _TextCollector()
    parser.feed(source)
    return re.sub(r"\s+", " ", " ".join(parser.parts)).strip()


def _required(pattern: str, text: str, label: str, flags: int = re.IGNORECASE) -> str:
    match = re.search(pattern, text, flags)
    if not match:
        raise ExtractionFailure(f"Could not extract {label}")
    value = match.group(1).strip()
    if not value:
        raise ExtractionFailure(f"Extracted an empty {label}")
    return value


def _date(value: str) -> datetime:
    return datetime.strptime(value, "%B %d, %Y")


def _eastern_datetime(date_value: str, time_value: str) -> str:
    clean_time = time_value.lower().replace(".", "").upper()
    combined = datetime.strptime(f"{date_value} {clean_time}", "%B %d, %Y %I:%M %p")
    return combined.replace(tzinfo=EASTERN).isoformat()


def _rate_label(value: str) -> str:
    number = Decimal(value)
    return format(number.normalize(), "f")


def extract_facts(filing_html: str, index_html: str) -> dict[str, str]:
    filing = html_text(filing_html)
    index = html_text(index_html)

    issuer = _required(r"\b(Strategy Inc)\s+\(Filer\)\s+CIK:", index, "issuer")
    cik = _required(r"\(Filer\)\s+CIK:\s*([0-9]{10})", index, "CIK")
    accession = _required(r"SEC Accession No\.\s*([0-9-]+)", index, "accession number")
    filing_date = _required(r"Filing Date\s*([0-9]{4}-[0-9]{2}-[0-9]{2})", index, "filing date")
    accepted = _required(
        r"Accepted\s*([0-9]{4}-[0-9]{2}-[0-9]{2}\s+[0-9]{2}:[0-9]{2}:[0-9]{2})",
        index,
        "acceptance time",
    )
    event_date = _required(
        r"Date of Report \(Date of earliest event reported\):\s*([A-Z][a-z]+\s+[0-9]{1,2},\s+[0-9]{4})",
        filing,
        "event date",
    )
    rate = _required(r"will be\s+([0-9]+(?:\.[0-9]+)?)%", filing, "STRC annual rate")
    trading_target = _required(r"trading near \$([0-9]+(?:\.[0-9]+)?) per share", filing, "trading target")
    record_start = _required(
        r"each calendar day from ([A-Z][a-z]+\s+[0-9]{1,2},\s+[0-9]{4}) through",
        filing,
        "first record date",
    )
    record_end = _required(
        r"each calendar day from [A-Z][a-z]+\s+[0-9]{1,2},\s+[0-9]{4} through ([A-Z][a-z]+\s+[0-9]{1,2},\s+[0-9]{4})",
        filing,
        "last record date",
    )
    total = _required(
        r"Total Attributable to November 2026 Record Dates\s*\$([0-9]+(?:\.[0-9]+)?)",
        filing,
        "November dividend total",
    )
    meeting_date = _required(
        r"special meeting[^.]*?held on ([A-Z][a-z]+\s+[0-9]{1,2},\s+[0-9]{4}) at",
        filing,
        "special-meeting date",
    )
    meeting_time = _required(
        r"special meeting[^.]*?held on [A-Z][a-z]+\s+[0-9]{1,2},\s+[0-9]{4} at ([0-9]{1,2}:[0-9]{2}\s+[ap]\.m\.)",
        filing,
        "special-meeting time",
    )
    approval_time = _required(
        r"at or prior to ([0-9]{1,2}:[0-9]{2}\s+[ap]\.m\.), New York City time, on October 31, 2026",
        filing,
        "approval deadline time",
    )
    effective_time = _required(
        r"at or prior to ([0-9]{1,2}:[0-9]{2}\s+[ap]\.m\.), Eastern time, on November 1, 2026",
        filing,
        "certificate deadline time",
    )

    required_phrases = {
        "fallback payment": "November 15 Dividend will be payable",
        "mutually exclusive payments": "In no event will both",
        "tax caveat": "non-taxable returns of capital",
    }
    for label, phrase in required_phrases.items():
        if phrase.casefold() not in filing.casefold():
            raise ExtractionFailure(f"Could not verify {label}")

    accepted_dt = datetime.strptime(accepted, "%Y-%m-%d %H:%M:%S").replace(tzinfo=EASTERN)
    return {
        "issuer": issuer,
        "cik": cik,
        "ticker": "MSTR",
        "accession": accession,
        "filingDate": filing_date,
        "acceptedAt": accepted_dt.isoformat(),
        "eventDate": _date(event_date).date().isoformat(),
        "rate": _rate_label(rate),
        "tradingTarget": format(Decimal(trading_target), ".0f"),
        "recordStart": _date(record_start).date().isoformat(),
        "recordEnd": _date(record_end).date().isoformat(),
        "total": format(Decimal(total), ".2f"),
        "meetingAt": _eastern_datetime(meeting_date, meeting_time),
        "approvalDeadline": _eastern_datetime("October 31, 2026", approval_time),
        "certificateDeadline": _eastern_datetime("November 1, 2026", effective_time),
    }



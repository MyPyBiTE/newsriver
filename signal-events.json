def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--filing-html", type=Path, required=True)
    parser.add_argument("--index-html", type=Path, required=True)
    parser.add_argument("--output", type=Path, required=True)
    parser.add_argument("--filing-url", default=DEFAULT_FILING_URL)
    parser.add_argument("--index-url", default=DEFAULT_INDEX_URL)
    parser.add_argument("--generated-at")
    return parser


def main() -> int:
    args = build_parser().parse_args()
    generated_at = args.generated_at or datetime.now(timezone.utc).replace(microsecond=0).isoformat().replace("+00:00", "Z")
    facts = extract_facts(
        args.filing_html.read_text(encoding="utf-8"),
        args.index_html.read_text(encoding="utf-8"),
    )
    event = build_event(facts, generated_at, args.filing_url, args.index_url)
    validate_event(event)
    args.output.parent.mkdir(parents=True, exist_ok=True)
    args.output.write_text(json.dumps(event, indent=2) + "\n", encoding="utf-8")
    print(f"Strategy Signal draft written: {args.output}")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://www.mypybite.com/schemas/signal-w5h-draft.v1.json",
  "title": "MYPYBITE Signal Private W5H Draft",
  "description": "A non-public, source-linked W5H assembly awaiting semantic analysis and publication gating.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "briefId", "packetId", "assembledAt", "status", "publicReleaseAllowed", "issuer", "filing", "sourcePacket", "headlineCandidate", "synopsisCandidate", "w5h", "unknowns", "quality", "evidence"],
  "properties": {
    "schema": {"const": "mypybite.signal-w5h-draft.v1"},
    "briefId": {"type": "string", "minLength": 1},
    "packetId": {"type": "string", "minLength": 1},
    "assembledAt": {"type": "string", "format": "date-time"},
    "status": {"const": "private-draft"},
    "publicReleaseAllowed": {"const": false},
    "issuer": {"type": "object"},
    "filing": {"type": "object"},
    "sourcePacket": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sha256"],
      "properties": {"sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}}
    },
    "headlineCandidate": {"type": "string", "minLength": 1, "maxLength": 200},
    "synopsisCandidate": {"type": "string", "minLength": 1, "maxLength": 800},
    "w5h": {
      "type": "object",
      "additionalProperties": false,
      "required": ["who", "what", "when", "where", "why", "how"],
      "properties": {
        "who": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/party"}},
        "what": {"$ref": "#/$defs/claim"},
        "when": {"type": "array", "items": {"$ref": "#/$defs/eventDate"}},
        "where": {"$ref": "#/$defs/claim"},
        "why": {"$ref": "#/$defs/claim"},
        "how": {"$ref": "#/$defs/claim"}
      }
    },
    "unknowns": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["dimension", "text"],
        "properties": {
          "dimension": {"enum": ["who", "what", "when", "where", "why", "how"]},
          "text": {"type": "string", "minLength": 1}
        }
      }
    },
    "quality": {
      "type": "object",
      "additionalProperties": false,
      "required": ["w5hFieldsPresent", "dimensionsSupported", "dimensionsNotDisclosed", "usesExactSourceLanguage", "requiresSemanticAnalysis", "publicationGatePassed"],
      "properties": {
        "w5hFieldsPresent": {"const": true},
        "dimensionsSupported": {"type": "array", "uniqueItems": true, "items": {"enum": ["who", "what", "when", "where", "why", "how"]}},
        "dimensionsNotDisclosed": {"type": "array", "uniqueItems": true, "items": {"enum": ["who", "what", "when", "where", "why", "how"]}},
        "usesExactSourceLanguage": {"const": true},
        "requiresSemanticAnalysis": {"const": true},
        "publicationGatePassed": {"const": false}
      }
    },
    "evidence": {"type": "array", "items": {"type": "object"}}
  },
  "$defs": {
    "party": {
      "type": "object",
      "additionalProperties": false,
      "required": ["text", "role", "status", "evidenceIds"],
      "properties": {
        "text": {"type": "string", "minLength": 1},
        "role": {"type": "string", "minLength": 1},
        "status": {"enum": ["verified-context", "disclosed"]},
        "evidenceIds": {"type": "array", "items": {"type": "string", "minLength": 1}}
      }
    },
    "claim": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "text", "evidenceIds"],
      "properties": {
        "status": {"enum": ["disclosed", "not-disclosed"]},
        "text": {"type": "string", "minLength": 1},
        "evidenceIds": {"type": "array", "items": {"type": "string", "minLength": 1}}
      }
    },
    "eventDate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["text", "value", "status", "evidenceIds"],
      "properties": {
        "text": {"type": "string", "minLength": 1},
        "value": {"type": "string", "minLength": 1},
        "status": {"enum": ["disclosed", "filed", "accepted", "scheduled", "deadline", "conditional", "effective"]},
        "evidenceIds": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
      }
    }
  }
}

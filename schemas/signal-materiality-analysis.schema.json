{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://www.mypybite.com/schemas/signal-materiality-analysis.v1.json",
  "title": "MYPYBITE Signal Private Materiality Analysis",
  "description": "A private, evidence-linked classification and consequence analysis for one SEC event.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "analysisId", "briefId", "analyzedAt", "status", "publicReleaseAllowed", "issuer", "filing", "sourceDraft", "headlineCandidate", "synopsisCandidate", "readerMeaning", "classification", "implications", "unknowns", "watchNext", "w5h", "evidence", "quality"],
  "properties": {
    "schema": {"const": "mypybite.signal-materiality-analysis.v1"},
    "analysisId": {"type": "string", "minLength": 1},
    "briefId": {"type": "string", "minLength": 1},
    "analyzedAt": {"type": "string", "format": "date-time"},
    "status": {"const": "private-analysis"},
    "publicReleaseAllowed": {"const": false},
    "issuer": {"type": "object"},
    "filing": {"type": "object"},
    "sourceDraft": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sha256"],
      "properties": {"sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}}
    },
    "headlineCandidate": {"type": "string", "minLength": 1},
    "synopsisCandidate": {"type": "string", "minLength": 1},
    "readerMeaning": {
      "type": "object",
      "additionalProperties": false,
      "required": ["plainLanguageSummary", "whyItMatters", "caution"],
      "properties": {
        "plainLanguageSummary": {"type": "string", "minLength": 1},
        "whyItMatters": {"type": "string", "minLength": 1},
        "caution": {"type": "string", "minLength": 1}
      }
    },
    "classification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["category", "categoryMatches", "direction", "directionMatches", "materiality", "materialityScore", "materialityReasons", "confidence", "confidenceReason", "structuralOddity"],
      "properties": {
        "category": {"enum": ["operations-and-outlook", "capital-allocation", "financing-and-dilution", "liquidity-and-solvency", "leadership-and-governance", "ownership-and-activism", "mergers-acquisitions-and-divestitures", "legal-and-regulatory", "accounting-and-disclosure-controls", "insider-transaction", "compensation", "other-disclosed-event"]},
        "categoryMatches": {"type": "array", "items": {"type": "string"}},
        "direction": {"enum": ["constructive", "adverse", "mixed", "neutral", "indeterminate"]},
        "directionMatches": {"type": "array", "items": {"type": "string"}},
        "materiality": {"enum": ["critical", "important", "notable", "routine"]},
        "materialityScore": {"type": "integer", "minimum": 0, "maximum": 100},
        "materialityReasons": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "confidence": {"enum": ["high", "moderate", "low"]},
        "confidenceReason": {"type": "string", "minLength": 1},
        "structuralOddity": {
          "type": "object",
          "additionalProperties": false,
          "required": ["flag", "explanation"],
          "properties": {
            "flag": {"type": "boolean"},
            "explanation": {"type": ["string", "null"]}
          }
        }
      }
    },
    "implications": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/implication"}},
    "unknowns": {"type": "array", "items": {"type": "object"}},
    "watchNext": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/checkpoint"}},
    "w5h": {"type": "object"},
    "evidence": {"type": "array", "minItems": 1, "items": {"type": "object"}},
    "quality": {
      "type": "object",
      "additionalProperties": false,
      "required": ["classificationRuleMatched", "materialityRuleMatched", "sourceEvidencePreserved", "semanticAnalysisComplete", "tradingRecommendationPresent", "publicationGatePassed"],
      "properties": {
        "classificationRuleMatched": {"type": "boolean"},
        "materialityRuleMatched": {"type": "boolean"},
        "sourceEvidencePreserved": {"const": true},
        "semanticAnalysisComplete": {"const": true},
        "tradingRecommendationPresent": {"const": false},
        "publicationGatePassed": {"const": false}
      }
    }
  },
  "$defs": {
    "implication": {
      "type": "object",
      "additionalProperties": false,
      "required": ["audience", "text", "evidenceIds", "caveat"],
      "properties": {
        "audience": {"enum": ["company", "common-shareholders", "preferred-shareholders", "debt-holders", "employees", "customers", "counterparties", "regulators", "other"]},
        "text": {"type": "string", "minLength": 1},
        "evidenceIds": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "caveat": {"type": "string", "minLength": 1}
      }
    },
    "checkpoint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["checkpoint", "dueAt", "evidenceToSeek", "evidenceIds"],
      "properties": {
        "checkpoint": {"type": "string", "minLength": 1},
        "dueAt": {"type": ["string", "null"]},
        "evidenceToSeek": {"type": "string", "minLength": 1},
        "evidenceIds": {"type": "array", "minItems": 1, "items": {"type": "string"}}
      }
    }
  }
}

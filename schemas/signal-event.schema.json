{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://www.mypybite.com/schemas/signal-event.v1.json",
  "title": "MYPYBITE Signal Event",
  "description": "An evidence-linked W5H event record for plain-language corporate disclosure intelligence.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "eventId",
    "generatedAt",
    "status",
    "issuer",
    "headline",
    "synopsis",
    "w5h",
    "implications",
    "unknowns",
    "watchNext",
    "classification",
    "sources",
    "evidence",
    "consolidation",
    "quality"
  ],
  "properties": {
    "schema": {
      "const": "mypybite.signal-event.v1"
    },
    "eventId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9:._-]+$"
    },
    "generatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "status": {
      "enum": ["draft", "reviewed", "publishable", "published"]
    },
    "issuer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cik", "legalName", "ticker"],
      "properties": {
        "cik": {
          "type": "string",
          "pattern": "^[0-9]{10}$"
        },
        "legalName": {
          "type": "string",
          "minLength": 1
        },
        "ticker": {
          "type": ["string", "null"]
        }
      }
    },
    "headline": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160,
      "description": "Actor, action, object, and the decisive condition or quantity."
    },
    "synopsis": {
      "type": "string",
      "minLength": 1,
      "maxLength": 420,
      "description": "A concrete statement of the disclosed action without form-level boilerplate."
    },
    "w5h": {
      "type": "object",
      "additionalProperties": false,
      "required": ["who", "what", "when", "where", "why", "how"],
      "properties": {
        "who": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/party"
          }
        },
        "what": {
          "$ref": "#/$defs/evidenceClaim"
        },
        "when": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/eventDate"
          }
        },
        "where": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/evidenceClaim"
          }
        },
        "why": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "text", "evidenceIds"],
          "properties": {
            "status": {
              "enum": ["disclosed", "not-disclosed", "inferred"]
            },
            "text": {
              "type": "string",
              "minLength": 1
            },
            "evidenceIds": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "how": {
          "$ref": "#/$defs/evidenceClaim"
        }
      }
    },
    "implications": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["audience", "text", "evidenceIds", "caveat"],
        "properties": {
          "audience": {
            "enum": [
              "company",
              "common-shareholders",
              "preferred-shareholders",
              "debt-holders",
              "employees",
              "customers",
              "counterparties",
              "regulators",
              "other"
            ]
          },
          "text": {
            "type": "string",
            "minLength": 1
          },
          "evidenceIds": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "caveat": {
            "type": ["string", "null"]
          }
        }
      }
    },
    "unknowns": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "watchNext": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["checkpoint", "dueAt", "evidenceToSeek"],
        "properties": {
          "checkpoint": {
            "type": "string",
            "minLength": 1
          },
          "dueAt": {
            "type": ["string", "null"],
            "format": "date-time"
          },
          "evidenceToSeek": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "classification": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "category",
        "direction",
        "materiality",
        "confidence",
        "structuralOddity"
      ],
      "properties": {
        "category": {
          "enum": [
            "operations-and-outlook",
            "capital-allocation",
            "financing-and-dilution",
            "liquidity-and-solvency",
            "leadership-and-governance",
            "ownership-and-activism",
            "mergers-acquisitions-and-divestitures",
            "legal-and-regulatory",
            "accounting-and-disclosure-controls",
            "insider-transaction",
            "compensation",
            "other-disclosed-event"
          ]
        },
        "direction": {
          "enum": ["constructive", "adverse", "mixed", "neutral", "indeterminate"]
        },
        "materiality": {
          "enum": ["critical", "important", "notable", "routine"]
        },
        "confidence": {
          "enum": ["high", "moderate", "low"]
        },
        "structuralOddity": {
          "type": "object",
          "additionalProperties": false,
          "required": ["flag", "explanation"],
          "properties": {
            "flag": {
              "type": "boolean"
            },
            "explanation": {
              "type": ["string", "null"]
            }
          }
        }
      }
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/source"
      }
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/evidence"
      }
    },
    "consolidation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["groupKey", "isPrimaryEvent", "relatedEventIds", "rationale"],
      "properties": {
        "groupKey": {
          "type": "string",
          "minLength": 1
        },
        "isPrimaryEvent": {
          "type": "boolean"
        },
        "relatedEventIds": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "rationale": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "quality": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "w5hComplete",
        "evidenceComplete",
        "quantitiesVerified",
        "humanReviewRequired",
        "humanReviewed"
      ],
      "properties": {
        "w5hComplete": {
          "type": "boolean"
        },
        "evidenceComplete": {
          "type": "boolean"
        },
        "quantitiesVerified": {
          "type": "boolean"
        },
        "humanReviewRequired": {
          "type": "boolean"
        },
        "humanReviewed": {
          "type": "boolean"
        },
        "reviewNotes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "reviewMethod": {
          "enum": ["human", "automated"]
        },
        "automatedReviewPassed": {
          "type": "boolean"
        },
        "automatedReviewChecks": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "quarantineReasons": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  },
  "$defs": {
    "party": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "role", "evidenceIds"],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "role": {
          "type": "string",
          "minLength": 1
        },
        "evidenceIds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "eventDate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["label", "value", "status", "evidenceIds"],
      "properties": {
        "label": {
          "type": "string",
          "minLength": 1
        },
        "value": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "enum": ["occurred", "filed", "accepted", "scheduled", "deadline", "conditional", "effective"]
        },
        "evidenceIds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "evidenceClaim": {
      "type": "object",
      "additionalProperties": false,
      "required": ["text", "evidenceIds"],
      "properties": {
        "text": {
          "type": "string",
          "minLength": 1
        },
        "evidenceIds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sourceId",
        "sourceType",
        "title",
        "url",
        "publishedAt",
        "primary"
      ],
      "properties": {
        "sourceId": {
          "type": "string",
          "minLength": 1
        },
        "sourceType": {
          "enum": [
            "sec-filing",
            "sec-exhibit",
            "company-statement",
            "regulatory-document",
            "secondary-context"
          ]
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "url": {
          "type": "string",
          "format": "uri"
        },
        "publishedAt": {
          "type": ["string", "null"],
          "format": "date-time"
        },
        "primary": {
          "type": "boolean"
        },
        "accessionNumber": {
          "type": ["string", "null"]
        },
        "form": {
          "type": ["string", "null"]
        }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["evidenceId", "sourceId", "locator", "fact"],
      "properties": {
        "evidenceId": {
          "type": "string",
          "minLength": 1
        },
        "sourceId": {
          "type": "string",
          "minLength": 1
        },
        "locator": {
          "type": "string",
          "minLength": 1,
          "description": "Section, item, exhibit, table, paragraph, or machine-readable locator."
        },
        "fact": {
          "type": "string",
          "minLength": 1
        },
        "quotedText": {
          "type": ["string", "null"],
          "maxLength": 500
        }
      }
    }
  }
}
